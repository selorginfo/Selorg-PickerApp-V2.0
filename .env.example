# Local development only. `npm start` / `npm run android` create/update a
# gitignored `.env` via scripts/ensure-dev-api-env.js — do not commit real IPs.
#
# DEV_API_HOST is auto-filled with this PC's LAN IPv4 so physical Android
# devices can reach selorg-service when Metro loads over adb reverse
# (scriptURL = 127.0.0.1).
DEV_API_HOST=
EXPO_PUBLIC_DEV_API_HOST=
DEV_API_PORT=3333
EXPO_PUBLIC_DEV_API_PORT=3333
